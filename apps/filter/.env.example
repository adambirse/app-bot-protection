# Copy to .env.local for `pnpm --filter @cms-bot/filter dev`.
PORT=3002
# Where allowed requests are forwarded (the site app).
SITE_ORIGIN=http://localhost:3001
# Published paths, stats and the on/off switch. Unset or unreachable = fail open.
REDIS_URL=redis://localhost:6379
# Sent to the site on every forwarded request so the site can refuse traffic that
# skipped the filter. At least 32 characters; required when NODE_ENV=production.
FILTER_ORIGIN_SECRET=local-filter-origin-secret-change-me-0001
# Optional: only accept requests from your Azure Front Door profile (its X-Azure-FDID).
# REQUIRED_FDID=
