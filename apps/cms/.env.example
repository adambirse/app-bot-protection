# Each app connects as its own least-privilege user (see packages/db/migrations/003_app_roles.sql).
DATABASE_URL=postgres://cms_user:CHANGE_ME@localhost:5432/cms_prototype
# Required. Password must be at least 9 characters.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
# Local development only: set to true to turn basic auth off. Refused in production.
# BASIC_AUTH_DISABLED=true

# Optional: the bot filter. Without REDIS_URL the CMS works as before and the
# Bot filter page says the filter is not configured.
REDIS_URL=redis://localhost:6379
# Optional: where the dashboard's demo attack buttons send traffic.
FILTER_URL=http://localhost:3002
SITE_URL=http://localhost:3001
