{
  "name": "cms-bot-protection",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @cms-bot/db migrate",
    "db:roles": "pnpm --filter @cms-bot/db roles",
    "db:setup": "pnpm db:migrate && pnpm db:roles",
    "dev": "pnpm --parallel --filter @cms-bot/cms --filter @cms-bot/site --filter @cms-bot/filter dev",
    "build": "pnpm --filter @cms-bot/cms --filter @cms-bot/site --filter @cms-bot/filter build",
    "typecheck": "pnpm -r typecheck",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "demo:attack": "tsx --env-file-if-exists=.env scripts/attack.mts"
  },
  "devDependencies": {
    "@cms-bot/filter-store": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
